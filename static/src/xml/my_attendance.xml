<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="attendance_kiosk_custom.MyAttendanceKiosk">
        <div class="o_my_attendance_kiosk container-fluid py-4">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
                <div>
                    <h1 class="mb-1">My Attendance</h1>
                    <div class="text-muted">Check in and out using your camera and GPS location.</div>
                </div>
                <button class="btn btn-outline-secondary" t-on-click="refreshStatus" t-att-disabled="state.busy">
                    <i class="fa fa-refresh me-1"/> Refresh
                </button>
            </div>
            <t t-if="state.loading">
                <div class="text-center py-5"><i class="fa fa-spinner fa-spin fa-2x"/> <p class="mt-2">Loading attendance...</p></div>
            </t>
            <t t-else="">
                <div class="row g-4">
                    <div class="col-12 col-xl-7">
                        <div class="card shadow-sm h-100"><div class="card-body p-3 p-lg-4">
                            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                                <div><div class="text-muted small">Employee</div><h3 class="mb-0" t-esc="state.employee_name"/></div>
                                <span t-att-class="state.checked_in ? 'badge rounded-pill text-bg-success fs-6' : 'badge rounded-pill text-bg-secondary fs-6'">
                                    <t t-esc="state.checked_in ? 'Checked In' : 'Checked Out'"/>
                                </span>
                            </div>
                            <div class="o_kiosk_camera mb-3">
                                <video t-ref="video" autoplay="autoplay" playsinline="playsinline"
                                       t-att-class="state.cameraReady ? 'o_kiosk_video is-visible' : 'o_kiosk_video'"/>
                                <t t-if="!state.cameraReady">
                                    <div class="o_kiosk_camera_placeholder">
                                        <i class="fa fa-camera fa-3x mb-2"/><div>Camera preview</div>
                                        <small class="text-muted">Start the camera to take a required photo</small>
                                    </div>
                                </t>
                                <t t-if="state.photoData"><img t-att-src="state.photoData" class="o_kiosk_photo_preview" alt="Captured attendance photo"/></t>
                            </div>
                            <canvas t-ref="canvas" class="d-none"/>
                            <div class="d-flex flex-wrap gap-2 mb-4">
                                <button class="btn btn-outline-primary" t-on-click="startCamera" t-att-disabled="state.busy"><i class="fa fa-video-camera me-1"/> Start Camera</button>
                                <button class="btn btn-primary" t-on-click="capturePhoto" t-att-disabled="!state.cameraReady || state.busy"><i class="fa fa-camera me-1"/> Capture Photo</button>
                                <button class="btn btn-outline-secondary" t-on-click="getLocation" t-att-disabled="state.busy"><i class="fa fa-map-marker me-1"/> Get GPS Location</button>
                            </div>
                            <div class="o_kiosk_location rounded p-3 mb-3">
                                <div class="fw-semibold mb-2"><i class="fa fa-map-pin me-2"/>GPS Location</div>
                                <t t-if="state.latitude !== null">
                                    <div>Latitude: <strong t-esc="state.latitude.toFixed(7)"/></div>
                                    <div>Longitude: <strong t-esc="state.longitude.toFixed(7)"/></div>
                                    <div>Accuracy: <strong t-esc="Math.round(state.accuracy)"/> meters</div>
                                </t>
                                <t t-else=""><span class="text-muted">Location not captured yet.</span></t>
                                <!-- <div class="small text-muted mt-2">Must be within 50 meters of the office; GPS accuracy must be 100 meters or better.</div> -->
                            </div>
                            <div t-if="state.error" class="alert alert-danger" role="alert"><i class="fa fa-exclamation-triangle me-2"/><t t-esc="state.error"/></div>
                            <button t-att-class="state.checked_in ? 'btn btn-danger btn-lg w-100' : 'btn btn-success btn-lg w-100'"
                                    t-on-click="submitAttendance"
                                    t-att-disabled="state.busy || !state.photoData || state.latitude === null || state.accuracy > 100">
                                <t t-if="state.busy"><i class="fa fa-spinner fa-spin me-2"/>Saving...</t>
                                <t t-else=""><i t-att-class="state.checked_in ? 'fa fa-sign-out me-2' : 'fa fa-sign-in me-2'"/><t t-esc="state.checked_in ? 'CHECK OUT' : 'CHECK IN'"/></t>
                            </button>
                            <div class="small text-muted mt-2 text-center">A fresh photo and GPS location are required for each action.</div>
                        </div></div>
                    </div>
                    <div class="col-12 col-xl-5">
                        <div class="card shadow-sm mb-4"><div class="card-body p-4">
                            <h4 class="mb-3"><i class="fa fa-clock-o me-2"/>Current Status</h4>
                            <t t-if="state.checked_in"><div class="text-muted small">Current check-in time</div><div class="fs-5 fw-semibold" t-esc="state.check_in"/><p class="text-muted mt-2 mb-0">Remember to check out before leaving the office.</p></t>
                            <t t-else=""><p class="mb-0">You are not currently checked in.</p></t>
                        </div></div>
                        <div class="card shadow-sm"><div class="card-body p-4">
                            <h4 class="mb-3"><i class="fa fa-shield me-2"/>Attendance Rules</h4>
                            <ul class="mb-0"><li class="mb-2">Camera photo is mandatory for check in and check out.</li><li class="mb-2">GPS is mandatory for check in and check out.</li><li>Location is validated again on the server.</li></ul>
                            <t t-if="!state.office_configured"><div class="alert alert-warning mt-3 mb-0">Office coordinates have not been configured. Ask an Attendance administrator to set them in Settings.</div></t>
                        </div></div>
                    </div>
                </div>
            </t>
        </div>
    </t>
</templates>
