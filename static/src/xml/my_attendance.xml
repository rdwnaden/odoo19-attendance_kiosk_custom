
<templates xml:space="preserve">

    <t t-name="attendance_kiosk_custom.MyAttendanceKiosk">
        <div class="o_my_attendance_kiosk container py-4">

            <div class="row justify-content-center">
                <div class="col-12 col-lg-8 col-xl-6">

                    <!-- Header -->
                    <div class="card shadow-sm mb-4">
                        <div class="card-body text-center">
                            <h2 class="mb-2">My Attendance</h2>
                            <p class="text-muted mb-0">
                                Take a photo and verify your location
                                to record attendance.
                            </p>
                        </div>
                    </div>

                    <!-- Attendance status -->
                    <div class="card shadow-sm mb-4">
                        <div class="card-body">
                            <h5 class="mb-3">Attendance Status</h5>

                            <t t-if="state.loading">
                                <div class="text-center py-3">
                                    <span class="spinner-border spinner-border-sm me-2"
                                          role="status"/>
                                    Loading attendance status...
                                </div>
                            </t>

                            <t t-else="">
                                <div class="d-flex justify-content-between align-items-center">
                                    <span>Employee</span>
                                    <strong>
                                        <t t-esc="state.employee_name || 'Current User'"/>
                                    </strong>
                                </div>

                                <hr/>

                                <div class="d-flex justify-content-between align-items-center">
                                    <span>Current Status</span>

                                    <span t-if="state.checked_in"
                                          class="badge text-bg-success">
                                        Checked In
                                    </span>

                                    <span t-else=""
                                          class="badge text-bg-secondary">
                                        Checked Out
                                    </span>
                                </div>
                            </t>

                            <t t-if="state.message">
                                <div class="alert alert-info mt-3 mb-0"
                                     role="status">
                                    <t t-esc="state.message"/>
                                </div>
                            </t>

                            <t t-if="state.error">
                                <div class="alert alert-danger mt-3 mb-0"
                                     role="alert">
                                    <t t-esc="state.error"/>
                                </div>
                            </t>
                        </div>
                    </div>

                    <!-- Camera and photo -->
                    <div class="card shadow-sm mb-4">
                        <div class="card-body">
                            <h5 class="mb-3">Attendance Photo</h5>

                            <div class="o_kiosk_camera mb-3"
                                 t-ref="videoContainer">

                                <!-- Dynamic camera video mount -->
                                <div t-ref="videoMount"
                                     class="o_kiosk_video_mount"/>

                                <!-- Camera placeholder -->
                                <t t-if="!state.cameraReady &amp;&amp; !state.photoData">
                                    <div class="o_kiosk_camera_placeholder">
                                        <i class="fa fa-camera fa-3x mb-3"
                                           aria-hidden="true"/>
                                        <p class="mb-0">
                                            Start the camera to take your photo.
                                        </p>
                                    </div>
                                </t>

                                <!-- Static captured photo -->
                                <t t-if="state.photoData">
                                    <img t-att-src="state.photoData"
                                         class="o_kiosk_photo_preview"
                                         alt="Captured attendance photo"/>
                                </t>
                            </div>

                            <canvas t-ref="canvas" class="d-none"/>

                            <div class="d-grid gap-2">

                                <!-- Start camera -->
                                <button t-if="!state.cameraReady &amp;&amp; !state.photoData"
                                        type="button"
                                        class="btn btn-outline-primary"
                                        t-on-click="startCamera"
                                        t-att-disabled="state.busy">
                                    <i class="fa fa-camera me-2"
                                       aria-hidden="true"/>
                                    Start Camera
                                </button>

                                <!-- Capture photo -->
                                <button t-if="state.cameraReady &amp;&amp; !state.photoData"
                                        type="button"
                                        class="btn btn-primary"
                                        t-on-click="capturePhoto"
                                        t-att-disabled="state.busy">
                                    <i class="fa fa-camera me-2"
                                       aria-hidden="true"/>
                                    Capture Photo
                                </button>

                                <!-- Retake photo -->
                                <button t-if="state.photoData"
                                        type="button"
                                        class="btn btn-outline-secondary"
                                        t-on-click="retakePhoto"
                                        t-att-disabled="state.busy">
                                    <i class="fa fa-refresh me-2"
                                       aria-hidden="true"/>
                                    Retake Photo
                                </button>
                            </div>

                            <t t-if="state.photoData">
                                <div class="alert alert-success mt-3 mb-0">
                                    <i class="fa fa-check-circle me-2"
                                       aria-hidden="true"/>
                                    Photo captured. The live camera is stopped.
                                </div>
                            </t>
                        </div>
                    </div>

                    <!-- GPS -->
                    <div class="card shadow-sm mb-4">
                        <div class="card-body">
                            <h5 class="mb-3">GPS Location</h5>

                            <button type="button"
                                    class="btn btn-outline-primary w-100 mb-3"
                                    t-on-click="getLocation"
                                    t-att-disabled="state.busy">
                                <i class="fa fa-map-marker me-2"
                                   aria-hidden="true"/>
                                Get GPS Location
                            </button>

                            <t t-if="state.latitude !== null &amp;&amp; state.longitude !== null">
                                <div class="small">
                                    <div class="mb-2">
                                        <strong>Latitude:</strong>
                                        <t t-esc="state.latitude"/>
                                    </div>

                                    <div class="mb-2">
                                        <strong>Longitude:</strong>
                                        <t t-esc="state.longitude"/>
                                    </div>

                                    <div>
                                        <strong>Accuracy:</strong>
                                        <t t-esc="state.accuracy"/> meters
                                    </div>
                                </div>

                                <div class="alert alert-success mt-3 mb-0">
                                    GPS received. The server must validate
                                    the office radius before accepting attendance.
                                </div>
                            </t>

                            <t t-else="">
                                <p class="text-muted mb-0">
                                    GPS location has not been retrieved.
                                    Allow location access in your browser.
                                </p>
                            </t>
                        </div>
                    </div>

                    <!-- Check In / Check Out -->
                    <div class="card shadow-sm">
                        <div class="card-body">
                            <h5 class="mb-3">Submit Attendance</h5>

                            <p class="text-muted small">
                                A photo and GPS location are required.
                                Your office distance is validated by the server.
                            </p>

                            <!-- Only show Check In when not checked in -->
                            <button t-if="!state.checked_in"
                                    type="button"
                                    class="btn btn-success btn-lg w-100"
                                    t-on-click="submitAttendance"
                                    t-att-disabled="state.busy || state.loading">
                                <t t-if="state.busy">
                                    <span class="spinner-border spinner-border-sm me-2"
                                          role="status"/>
                                    Processing...
                                </t>
                                <t t-else="">
                                    <i class="fa fa-sign-in me-2"
                                       aria-hidden="true"/>
                                    Check In
                                </t>
                            </button>

                            <!-- Only show Check Out when already checked in -->
                            <button t-else=""
                                    type="button"
                                    class="btn btn-danger btn-lg w-100"
                                    t-on-click="submitAttendance"
                                    t-att-disabled="state.busy || state.loading">
                                <t t-if="state.busy">
                                    <span class="spinner-border spinner-border-sm me-2"
                                          role="status"/>
                                    Processing...
                                </t>
                                <t t-else="">
                                    <i class="fa fa-sign-out me-2"
                                       aria-hidden="true"/>
                                    Check Out
                                </t>
                            </button>
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </t>

</templates>
