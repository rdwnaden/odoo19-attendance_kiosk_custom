
<!-- <?xml version="1.0" encoding="UTF-8"?> -->
<templates xml:space="preserve">

    <t t-name="attendance_kiosk_custom.MyAttendanceKiosk">
        <div class="o_my_attendance_kiosk container py-4">

            <div class="row justify-content-center">
                <div class="col-12 col-lg-8 col-xl-6">

                    <!-- Header -->
                    <div class="card shadow-sm mb-4">
                        <div class="card-body text-center">
                            <h2 class="mb-2">My Attendance</h2>
                            <p class="text-muted mb-0">
                                Take a photo and verify your location
                                to record attendance.
                            </p>
                        </div>
                    </div>

                    <!-- Attendance status -->
                    <div class="card shadow-sm mb-4">
                        <div class="card-body">
                            <h5 class="mb-3">Attendance Status</h5>

                            <t t-if="state.loading">
                                <div class="text-center py-3">
                                    <span class="spinner-border spinner-border-sm me-2"
                                          role="status"/>
                                    Loading attendance status...
                                </div>
                            </t>

                            <t t-else="">
                                <div class="d-flex justify-content-between
                                            align-items-center mb-2">
                                    <span>Current Status</span>

                                    <span t-if="state.attendanceStatus === 'checked_in'"
                                          class="badge text-bg-success">
                                        Checked In
                                    </span>

                                    <span t-elif="state.attendanceStatus === 'checked_out'"
                                          class="badge text-bg-secondary">
                                        Checked Out
                                    </span>

                                    <span t-else=""
                                          class="badge text-bg-secondary">
                                        Not Available
                                    </span>
                                </div>
                            </t>

                            <t t-if="state.message">
                                <div class="alert alert-info mt-3 mb-0"
                                     role="status">
                                    <t t-esc="state.message"/>
                                </div>
                            </t>

                            <t t-if="state.error">
                                <div class="alert alert-danger mt-3 mb-0"
                                     role="alert">
                                    <t t-esc="state.error"/>
                                </div>
                            </t>
                        </div>
                    </div>

                    <!-- Camera -->
                    <div class="card shadow-sm mb-4">
                        <div class="card-body">
                            <h5 class="mb-3">Attendance Photo</h5>

                            <div class="o_kiosk_camera mb-3"
                                 t-ref="videoContainer">

                                <!-- Dedicated mount point for the dynamic video.
                                     Keep this element in the XML. -->
                                <div t-ref="videoMount"
                                     class="o_kiosk_video_mount"/>

                                <t t-if="!state.cameraReady">
                                    <div class="o_kiosk_camera_placeholder">
                                        <i class="fa fa-camera fa-3x mb-3"
                                           aria-hidden="true"/>
                                        <p class="mb-0">
                                            Start the camera to take your photo.
                                        </p>
                                    </div>
                                </t>

                                <t t-if="state.photoData">
                                    <img t-att-src="state.photoData"
                                         class="o_kiosk_photo_preview"
                                         alt="Attendance photo preview"/>
                                </t>
                            </div>

                            <canvas t-ref="canvas" class="d-none"/>

                            <div class="d-grid gap-2">
                                <button type="button"
                                        class="btn btn-outline-primary"
                                        t-on-click="startCamera"
                                        t-att-disabled="state.submitting">
                                    <i class="fa fa-camera me-2"
                                       aria-hidden="true"/>
                                    Start Camera
                                </button>

                                <button type="button"
                                        class="btn btn-primary"
                                        t-on-click="capturePhoto"
                                        t-att-disabled="!state.cameraReady || state.submitting">
                                    <i class="fa fa-picture-o me-2"
                                       aria-hidden="true"/>
                                    Capture Photo
                                </button>

                                <button type="button"
                                        class="btn btn-outline-secondary"
                                        t-on-click="stopCamera"
                                        t-att-disabled="!state.cameraReady || state.submitting">
                                    <i class="fa fa-stop me-2"
                                       aria-hidden="true"/>
                                    Stop Camera
                                </button>
                            </div>

                            <t t-if="state.photoData">
                                <div class="alert alert-success mt-3 mb-0">
                                    <i class="fa fa-check-circle me-2"
                                       aria-hidden="true"/>
                                    Photo captured successfully.
                                </div>
                            </t>
                        </div>
                    </div>

                    <!-- GPS -->
                    <div class="card shadow-sm mb-4">
                        <div class="card-body">
                            <h5 class="mb-3">GPS Location</h5>

                            <div class="d-grid mb-3">
                                <button type="button"
                                        class="btn btn-outline-primary"
                                        t-on-click="getLocation"
                                        t-att-disabled="state.submitting">
                                    <i class="fa fa-map-marker me-2"
                                       aria-hidden="true"/>
                                    Get GPS Location
                                </button>
                            </div>

                            <t t-if="state.latitude !== false &amp;&amp; state.latitude !== null">
                                <div class="small">
                                    <div class="mb-2">
                                        <strong>Latitude:</strong>
                                        <span t-esc="state.latitude"/>
                                    </div>

                                    <div class="mb-2">
                                        <strong>Longitude:</strong>
                                        <span t-esc="state.longitude"/>
                                    </div>

                                    <div class="mb-2">
                                        <strong>Accuracy:</strong>
                                        <span t-esc="state.accuracy"/>
                                        meters
                                    </div>
                                </div>

                                <div class="alert alert-success mb-0 mt-3">
                                    <i class="fa fa-check-circle me-2"
                                       aria-hidden="true"/>
                                    GPS coordinates received. The server will
                                    validate the office radius.
                                </div>
                            </t>

                            <t t-else="">
                                <p class="text-muted mb-0">
                                    GPS location has not been retrieved yet.
                                    Allow location access in your browser.
                                </p>
                            </t>
                        </div>
                    </div>

                    <!-- Submit attendance -->
                    <div class="card shadow-sm">
                        <div class="card-body">
                            <h5 class="mb-3">Submit Attendance</h5>

                            <p class="text-muted small">
                                A photo and GPS location are required.
                                Attendance is subject to server-side
                                location validation.
                            </p>

                            <div class="d-grid gap-2">
                                <button type="button"
                                        class="btn btn-success btn-lg"
                                        t-on-click="checkIn"
                                        t-att-disabled="state.submitting || state.loading || state.attendanceStatus === 'checked_in'">
                                    <t t-if="state.submitting">
                                        <span class="spinner-border spinner-border-sm me-2"
                                              role="status"/>
                                        Processing...
                                    </t>
                                    <t t-else="">
                                        <i class="fa fa-sign-in me-2"
                                           aria-hidden="true"/>
                                        Check In
                                    </t>
                                </button>

                                <button type="button"
                                        class="btn btn-danger btn-lg"
                                        t-on-click="checkOut"
                                        t-att-disabled="state.submitting || state.loading || state.attendanceStatus !== 'checked_in'">
                                    <t t-if="state.submitting">
                                        <span class="spinner-border spinner-border-sm me-2"
                                              role="status"/>
                                        Processing...
                                    </t>
                                    <t t-else="">
                                        <i class="fa fa-sign-out me-2"
                                           aria-hidden="true"/>
                                        Check Out
                                    </t>
                                </button>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </t>

</templates>
